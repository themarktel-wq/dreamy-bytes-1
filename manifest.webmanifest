  "description": "PTA approved phones, original accessories, easy qist, trade-in and same-day delivery in Lahore.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#07110e",
