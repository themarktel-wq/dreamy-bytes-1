   "id": "61b03a58-580a-5672-b2c7-8d3917460477",
   "name": "Read Bookings",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    680,
    300
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
     "id": "",
     "name": "Google Sheets account"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "const c = $('Config').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.booking_id);\nconst today = new Date(); today.setUTCHours(0, 0, 0, 0);\nconst from = new Date(today.getTime() - 7 * 864e5).toISOString().slice(0, 10);\nconst to = today.toISOString().slice(0, 10);\nconst wk = rows.filter(r => { const d = String(r.date).slice(0, 10); return d >= from && d < to; });\nconst st = r => String(r.status || '').trim().toLowerCase();\nconst completed = wk.filter(r => st(r) === 'completed').length;\nconst noshow = wk.filter(r => st(r) === 'no-show');\nconst cancelled = wk.filter(r => st(r) === 'cancelled').length;\nconst lost = noshow.reduce((s, r) => s + (parseFloat(String(r.price || '').replace(/[^0-9.]/g, '')) || 0), 0);\nconst held = completed + noshow.length;\nconst rate = held ? Math.round(1000 * noshow.length / held) / 10 : 0;\nreturn [{ json: { week_start: from, week_end: to, appointments: wk.length, completed, no_shows: noshow.length, cancellations: cancelled, no_show_rate_pct: rate, est_lost_revenue: Math.round(lost * 100) / 100 } }];"
   },
   "id": "370db2c3-0d11-5ffc-bae3-52d1e2f5f0f5",
