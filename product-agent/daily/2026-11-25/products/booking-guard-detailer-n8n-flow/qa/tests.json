 {
  "file": "booking-guard-03-weather-reschedule.json",
  "title": "weather reschedule moves the booking, transfers the deposit and resets reminders",
  "sample": {
   "booking_id": "B30",
   "new_date": "2099-03-05",
   "new_time": "10:30"
  },
  "query": {},
  "mocks": {
   "Read Bookings": [
    {
     "booking_id": "B30",
     "date": "2026-11-26",
     "time": "21:09",
     "client": "Dana Smith",
     "phone": "+15551230001",
     "email": "dana@example.com",
     "address": "12 Oak St",
     "vehicle": "2019 Ford F-150",
     "package": "Full detail",
     "price": "$240",
     "status": "Booked",
     "deposit_status": "paid",
     "access_confirmed": "",
     "weather_hold": "notified",
     "r48_sent": "yes",
     "r24_sent": "yes",
     "risk_flag": "yes"
    }
   ]
  },
  "expect": [
   "Move booking",
   "Confirm by SMS",
   "Tell owner moved"
  ],
  "notexpect": [
   "Tell owner problem",
   "Confirm by email"
  ],
  "contains": [
   [
    "Move booking",
    "\"date\":\"2099-03-05\""
   ],
   [
    "Move booking",
    "\"deposit_status\":\"transferred (weather)\""
   ],
   [
    "Move booking",
    "\"r48_sent\":\"\""
   ],
   [
    "Move booking",
    "\"weather_hold\":\"\""
   ],
   [
    "Confirm by SMS",
    "carries over"
   ],
   [
    "Confirm by SMS",
    "2099-03-05"
   ]
  ],
  "trigger": "x"
 },
