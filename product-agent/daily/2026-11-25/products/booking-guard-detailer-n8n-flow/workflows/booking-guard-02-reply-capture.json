   "id": "78fc3d3a-d55a-54c0-bb10-392cb8309d44",
   "name": "Read Bookings",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    900,
    300
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
     "id": "",
     "name": "Google Sheets account"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "const n = $('Normalize').first().json;\nconst c = $('Config').first().json;\nconst now = Date.now();\nconst rows = $input.all().map(i => i.json).filter(r => r && r.booking_id);\nconst mine = rows.filter(r => n.from && String(r.phone || '').replace(/\\D/g, '').slice(-10) === n.from && ['booked', 'confirmed'].includes(String(r.status || '').trim().toLowerCase()))\n  .map(r => ({ r, t: new Date(String(r.date).slice(0, 10) + 'T' + String(r.time || '09:00').padStart(5, '0') + ':00' + c.tzOffset).getTime() }))\n  .filter(x => x.t > now).sort((a, b) => a.t - b.t);\nif (!mine.length) return [{ json: { found: false, from: n.from, intent: n.intent, raw: n.raw } }];\nconst r = mine[0].r;\nconst hours = (mine[0].t - now) / 36e5;\nconst notice = Number(c.noticeHours) || 24;\nconst late = hours < notice;\nconst dep = String(r.deposit_status || '');\nconst hasDep = /^(paid|requested)/i.test(dep) && !/forfeit|refund/i.test(dep);\nconst new_dep = late ? (hasDep ? 'forfeited (late cancel)' : dep) : (hasDep ? 'refund due' : dep);\nreturn [{ json: { found: true, booking_id: r.booking_id, client: r.client, vehicle: String(r.vehicle || '').trim() || 'your vehicle', when: String(r.date).slice(0, 10) + ' at ' + r.time, phone: r.phone, intent: n.intent, raw: n.raw, from: n.from, late, notice, hasDep, new_dep, hours: Math.round(hours * 10) / 10 } }];"
   },
