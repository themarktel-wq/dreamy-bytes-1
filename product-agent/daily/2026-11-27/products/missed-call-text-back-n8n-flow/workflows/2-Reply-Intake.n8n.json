   "id": "077e92f6-5b1d-5d43-9603-d1439beba184",
   "name": "Reply to Twilio",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    680,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body || {};\nreturn [{json:{from:String(b.From||'').trim(), text:String(b.Body||'')}}];"
   },
   "id": "f651c912-b2df-5c7c-be34-95cc1b4ce829",
   "name": "Normalize",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const c = $('Config').first().json, b = $('Normalize').first().json;\nconst text = String(b.text || '').trim().slice(0, 1000), lower = text.toLowerCase();\nconst now = /^\\d{4}-\\d{2}-\\d{2}/.test(String(c.testNow || '')) ? new Date(c.testNow).toISOString() : new Date().toISOString();\nif (/^\\s*(stop|stopall|unsubscribe|cancel|end|quit)\\s*$/i.test(text)) return [{ json: { optOut: true, row: { received_at: now, phone: b.from, name: '', address: '', job_type: '', details: text, urgency: '', status: 'opted_out' } } }];\nconst parts = text.split(/(?:^|\\s)([1-4])[).:\\-]\\s*/), f = {};\nfor (let i = 1; i + 1 < parts.length; i += 2) f[parts[i]] = parts[i + 1].trim();\nconst words = String(c.urgentWords || 'emergency,flood,flooding,burst,no heat,no hot water,gas smell,gas leak,sparks,smoke,asap,urgent').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nconst yes = /^(y|yes|yeah|urgent|asap)\\b/i.test(f['4'] || '');\nconst urgent = yes || words.some(w => lower.includes(w));\nconst jobText = f['3'] || text;\nconst groups = { Plumbing: ['leak', 'pipe', 'drain', 'clog', 'toilet', 'faucet', 'tap', 'water heater', 'sewer', 'sink'], HVAC: ['heat', 'furnace', 'a/c', 'air condition', 'cooling', 'thermostat', 'boiler', ' ac '], Electrical: ['outlet', 'breaker', 'wiring', 'power', 'panel', 'sparks'] };\nlet job = 'Other'; const jl = (' ' + jobText.toLowerCase() + ' ');\nfor (const [k, ws] of Object.entries(groups)) { if (ws.some(w => jl.includes(w))) { job = k; break; } }\nconst row = { received_at: now, phone: b.from, name: f['1'] || '', address: f['2'] || '', job_type: job, details: jobText.slice(0, 300), urgency: urgent ? 'URGENT' : 'normal', status: Object.keys(f).length ? 'Reply received' : 'Reply received (unstructured)' };\nreturn [{ json: { optOut: false, row } }];"
   },
