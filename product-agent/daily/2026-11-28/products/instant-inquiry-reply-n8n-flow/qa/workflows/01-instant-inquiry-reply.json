  {
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body || {};\nconst nm = b.name || [b.first_name, b.last_name].filter(Boolean).join(' ');\nreturn [{json:{name:nm, email:b.email, phone:b.phone || b.mobile, message:b.message || b.comments, property:b.property || b.listing || b.address || b.interested_in, source:b.source, honeypot:b.website || b.hp}}];"
   },
   "id": "777036d2-91f3-545b-b27c-4e1e0467d708",
   "name": "Normalize",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    300
   ]
  },
  {
   "parameters": {
    "resource": "sheet",
    "operation": "read",
    "documentId": {
     "__rl": true,
     "value": "={{ $('Config').first().json.sheetId }}",
     "mode": "id"
    },
    "sheetName": {
     "__rl": true,
     "value": "Leads",
     "mode": "name"
    },
    "options": {}
   },
   "id": "eb4036f9-a126-5cfc-889f-9ef14984aac3",
   "name": "Read leads",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    1120,
    300
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
     "id": "",
     "name": "Google Sheets account"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "const c = $('Config').first().json, b = $('Normalize').first().json;\nconst now = /^\\d{4}-\\d{2}-\\d{2}/.test(String(c.testNow || '')) ? new Date(c.testNow).getTime() : Date.now();\nconst none = reason => [{ json: { skip: true, reason } }];\nconst clean = (s, n) => String(s == null ? '' : s).replace(/[\\u0000-\\u001f\\u007f]+/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, n || 200);\nif (clean(b.honeypot)) return none('spam (honeypot filled)');\nconst email = clean(b.email, 120).toLowerCase(), phone = clean(b.phone, 40), name = clean(b.name, 80), property = clean(b.property, 120), source = clean(b.source, 60) || 'Website form', message = String(b.message == null ? '' : b.message).replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]/g, '').trim().slice(0, 1000);\nconst emailOk = /^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]{2,}$/.test(email);\nif (!emailOk && !phone) return none('no usable contact details');\nconst dedupe = Number(c.dedupeHours || 24) * 36e5;\nconst rows = $('Read leads').all().map(i => i.json);\nconst dup = emailOk && rows.some(r => String(r.email || '').trim().toLowerCase() === email && r.received_at && now >= new Date(r.received_at).getTime() && now - new Date(r.received_at).getTime() < dedupe);\nconst first = (name.split(' ')[0] || 'there');\nconst action = emailOk && !dup ? 'reply' : 'log_only';\nconst status = !emailOk ? 'New - no valid email, call or text' : (dup ? 'Duplicate inquiry (already replied)' : 'New - replied');\nconst agent = c.agentName || 'your agent', brokerage = c.brokerage ? ' with ' + c.brokerage : '', win = c.responseWindow || 'shortly';\nconst about = property ? ' about ' + property : '';\nconst subject = 'Thanks for your inquiry' + about;\nconst body = 'Hi ' + first + ',\\n\\nThanks for reaching out' + about + '. I am ' + agent + brokerage + '. I have your message and will follow up personally ' + win + '.\\n\\n' + (c.bookingLink ? 'If you would like to pick a time to talk or see a home, you can book here: ' + c.bookingLink + '\\n\\n' : '') + 'You can also call or text me at ' + (c.agentPhone || 'the number on my website') + '.\\n\\n' + agent + '\\n\\n--\\nYou are receiving this because you sent an inquiry. Reply \"unsubscribe\" and I will not email you again.' + (c.postalAddress ? '\\n' + c.postalAddress : '');\nconst row = { received_at: new Date(now).toISOString(), name, email, phone, property, source, message: message.slice(0, 500), status, contacted: '' };\nreturn [{ json: { skip: false, action, to: email, subject, body, row, alert: (action === 'reply' ? 'New inquiry (auto-replied)' : (dup ? 'Repeat inquiry' : 'New inquiry (needs a call or text)')) + ': ' + (name || 'no name') + ', ' + (phone || email) + (property ? ', ' + property : '') } }];"
   },
