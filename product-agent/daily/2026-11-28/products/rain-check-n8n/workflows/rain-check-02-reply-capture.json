   "id": "456dacce-368e-5094-8ada-b94154db7dad",
   "name": "Config",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    460,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const b = $input.first().json.body || {};\nconst raw=String(b.Body||b.body||'').trim().toUpperCase();const from=String(b.From||b.from||'').replace(/\\D/g,'').slice(-10);const intent=/^(OK|OKAY|YES|Y|CONFIRM|CONFIRMED)\\b/.test(raw)?'confirm':(/^(CALL|NO|N)\\b/.test(raw)?'call':'other');return [{json:{from,raw:String(b.Body||b.body||'').trim(),intent}}];"
   },
   "id": "66e15af9-3ff5-5f5b-9641-147b9e83694e",
