   "id": "78fc3d3a-d55a-54c0-bb10-392cb8309d44",
   "name": "Read Bookings",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    900,
    300
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
     "id": "",
     "name": "Google Sheets account"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "const n = $('Normalize').first().json;\nconst c = $('Config').first().json;\nconst now = Date.now();\nconst rows = $input.all().map(i => i.json).filter(r => r && r.booking_id);\nconst mine = rows.filter(r => String(r.phone || '').replace(/\\D/g, '').slice(-10) === n.from && n.from && ['booked', 'confirmed'].includes(String(r.status || '').trim().toLowerCase()))\n  .map(r => ({ r, t: new Date(String(r.date).slice(0, 10) + 'T' + String(r.time || '09:00').padStart(5, '0') + ':00' + c.tzOffset).getTime() }))\n  .filter(x => x.t > now).sort((a, b) => a.t - b.t);\nif (!mine.length) return [{ json: { found: false, from: n.from, intent: n.intent, raw: n.raw } }];\nconst r = mine[0].r;\nreturn [{ json: { found: true, booking_id: r.booking_id, client: r.client, dog: r.dog || 'your pup', when: String(r.date).slice(0, 10) + ' at ' + r.time, phone: r.phone, intent: n.intent, raw: n.raw, from: n.from } }];"
   },
