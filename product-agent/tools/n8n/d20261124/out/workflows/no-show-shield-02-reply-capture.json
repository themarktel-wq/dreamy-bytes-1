  },
  {
   "parameters": {
    "jsCode": "const b = $input.first().json.body || {};\nconst raw=String(b.Body||b.body||'').trim().toUpperCase();const from=String(b.From||b.from||'').replace(/\\D/g,'').slice(-10);const intent=/^(Y|YES|YEP|CONFIRM|CONFIRMED)\\b/.test(raw)?'yes':(/^(N|NO|CANCEL|CANCELLED|CANCELED)\\b/.test(raw)?'no':'other');return [{json:{from,raw:String(b.Body||b.body||'').trim(),intent}}];"
   },
   "id": "66e15af9-3ff5-5f5b-9641-147b9e83694e",
   "name": "Normalize",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    680,
    300
   ]
  },
  {
   "parameters": {
    "resource": "sheet",
    "operation": "read",
    "documentId": {
     "__rl": true,
     "value": "={{ $('Config').first().json.sheetId }}",
