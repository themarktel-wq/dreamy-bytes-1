  {
   "parameters": {
    "jsCode": "const b = $('Normalize').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.booking_id);\nconst r = rows.find(x => String(x.booking_id) === String(b.booking_id));\nif (!r) return [];\nreturn [{ json: { booking_id: r.booking_id, date: String(r.date).slice(0, 10), time: r.time, service: r.service || 'appointment', client: r.client, dog: r.dog, reason: b.reason || '' } }];"
   },
