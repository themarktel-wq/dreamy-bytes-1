    "jsCode": "const b = $input.first().json.body || {};\nconst today = new Date().toISOString().slice(0, 10);return [{json:{day:String(b.day||today).slice(0,10),newDay:String(b.newDay||'').slice(0,10),reason:String(b.reason||'rain')}}];"
