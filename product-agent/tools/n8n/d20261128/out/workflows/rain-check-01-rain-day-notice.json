   "id": "cb0fe028-7ce9-5965-a282-04fde45dd749",
   "name": "Read Schedule",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    900,
    300
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
