      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "5d9bc8de-7b3e-5e25-a152-9e4633d161fe",
       "leftValue": "={{ !!($('Config').first().json.autoSend === 'yes') }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
