   "parameters": {
    "method": "GET",
    "url": "=https://api.openweathermap.org/data/2.5/forecast",
    "sendQuery": true,
    "specifyQuery": "json",
    "jsonQuery": "={{ JSON.stringify({lat: $('Config').first().json.weatherLat, lon: $('Config').first().json.weatherLon, appid: $('Config').first().json.weatherApiKey, units: 'metric'}) }}",
    "options": {}
   },
   "id": "77c781fa-4557-557a-8990-1b4b6cfc045a",
   "name": "Get forecast",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    680,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const c = $('Config').first().json;\nconst today = new Date().toISOString().slice(0, 10);\nconst list = ($input.first().json.list || []).filter(x => String(x.dt_txt || '').slice(0, 10) === today);\nif (!list.length) return [];\nconst maxPop = Math.max(...list.map(x => Number(x.pop) || 0)) * 100; const th = Number(c.rainThreshold);\nif (!(maxPop >= th)) return [];\nreturn [{ json: { day: today, pop: Math.round(maxPop), subject: 'Rain likely today (' + Math.round(maxPop) + '%)', text: 'The forecast shows up to ' + Math.round(maxPop) + '% chance of rain today (' + today + '). To send reschedule notices to today\\'s customers, open the Rain Check workflow 1 trigger: POST {\"day\":\"' + today + '\"} to ' + c.rainWebhookUrl + '.' } }];"
   },
   "id": "d70c32d1-7bbb-5b3c-8472-520a71c88ab4",
   "name": "Rain today?",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    300
   ]
  },
  {
